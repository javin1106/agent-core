# Copy this file to .env and fill it in. Never commit .env.
# The openai SDK reads OPENAI_API_KEY and OPENAI_BASE_URL by itself.

# --- Local Ollama (free) ---
# Ollama speaks the same API as OpenAI. It ignores the key, but the SDK needs one set.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:8b

# --- Real OpenAI (paid) ---
# Remove OPENAI_BASE_URL, put your real key in OPENAI_API_KEY, and pick an OpenAI model.

# --- Cost estimate (optional) ---
# US dollars per 1 million tokens, from your provider's pricing page.
# Leave both out for free models; then only token counts are shown.
# PRICE_INPUT_PER_M=2.50
# PRICE_OUTPUT_PER_M=10.00
